# Copy to .env and fill in real values. .env is gitignored; this file is not.
# Every variable the app reads should appear here, with a placeholder value and a
# comment saying where to get it. A missing entry here is a missing entry in onboarding.
#
# v1 needs no secrets. Every path below has a working default for the standard layout
# (docs/03-architecture.md) - set one only if you moved that folder.

# Where uploads, stems, clips, runs, the SQLite db and model caches live.
# DATA_DIR=D:/music-trainer-data

# Applio checkout at the pinned commit, and the engine venv's interpreter.
# APPLIO_ROOT=D:/music-trainer/engine/applio
# ENGINE_PYTHON=D:/music-trainer/engine/.venv/Scripts/python.exe

# Scripts the worker runs inside the engine venv.
# ENGINE_SCRIPTS_DIR=D:/music-trainer/backend/engine_scripts

# development | production
ENVIRONMENT=development
